{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Native (Linux/macOS, or Windows with whatever compiler is on PATH)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64",
      "inherits": "default",
      "displayName": "Windows x64 (LLVM-MinGW)",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++"
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "default",
      "displayName": "Windows ARM64 (LLVM-MinGW)",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "CMAKE_C_COMPILER": "aarch64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "aarch64-w64-mingw32-clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "windows-arm64", "configurePreset": "windows-arm64" }
  ]
}
